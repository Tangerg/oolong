# Binaries built from the examples and from any local scratch command.
/bin/
# `go build ./examples/name` writes a root-level binary named after the command.
/dashboard
/files
/form
/hello
/picker
/read
/run
/streaming
*.exe
*.test

# Coverage and profiling output.
*.out
*.prof
coverage.*

# go.work is committed, not ignored. That guidance is for a single-module
# library, where a workspace file is one developer's local arrangement; here it
# is the repository's structure, and a checkout without it does not build. Only
# the checksum file, which is derived, stays out.
go.work.sum

# Editor and OS leavings. Kept here rather than in a personal global ignore file
# because a contributor on a different editor should not have to discover this.
.idea/
.vscode/
.DS_Store
*~

# VitePress dependencies and generated site state.
node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/
# Brand ideation is working material, not a website or clone dependency. Keep only
# the two approved raster marks in the site; ignore future exploration batches.
docs/public/brand/*
!docs/public/brand/oolong-wordmark.png
!docs/public/brand/oolong-icon.png
