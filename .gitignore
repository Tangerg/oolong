# Binaries built from the examples and from any local scratch command.
/bin/
*.exe
*.test

# Coverage and profiling output.
*.out
*.prof
coverage.*

# A workspace file is a local arrangement — which sibling checkouts this module
# is being developed against — and not something a consumer of the library has
# any use for. Go's own guidance is not to commit one from a module that is a
# dependency.
go.work
go.work.sum

# Editor and OS leavings. Kept here rather than in a personal global ignore file
# because a contributor on a different editor should not have to discover this.
.idea/
.vscode/
.DS_Store
*~
