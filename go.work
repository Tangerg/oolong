go 1.27.0

// Modules are distribution units. Packages inside ui own the UI layers.
use (
	./examples
	./extensions/highlight
	./extensions/latex
	./extensions/markdown
	./extensions/mermaid
	./extensions/ssh
	./ui
)

// Versioned replacements are derived by scripts/sync-workspace.sh.
// Required metadata is local even before a module has its first tag.
replace (
	github.com/Tangerg/oolong/extensions/highlight v0.0.0 => ./extensions/highlight
	github.com/Tangerg/oolong/extensions/latex v0.0.0 => ./extensions/latex
	github.com/Tangerg/oolong/extensions/markdown v0.0.0 => ./extensions/markdown
	github.com/Tangerg/oolong/extensions/mermaid v0.0.0 => ./extensions/mermaid
	github.com/Tangerg/oolong/ui v0.0.0 => ./ui
)
