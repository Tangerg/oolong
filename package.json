{
  "name": "oolong-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:lint": "markdownlint-cli2",
    "spell": "cspell --no-progress --no-summary",
    "docs:check": "npm audit --audit-level=moderate && npm run spell && npm run docs:lint && npm run docs:build"
  },
  "devDependencies": {
    "cspell": "10.1.1",
    "markdownlint-cli2": "0.23.2",
    "vitepress": "2.0.0-alpha.19"
  }
}
