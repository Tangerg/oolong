{
  "name": "oolong-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:lint": "node scripts/lint-markdown.mjs",
    "spell": "cspell --no-progress --no-summary",
    "docs:check": "npm audit --audit-level=moderate && npm run spell && npm run docs:lint && npm run docs:build"
  },
  "devDependencies": {
    "cspell": "10.3.6",
    "markdownlint": "0.41.1",
    "vitepress": "2.0.0-alpha.20"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  }
}
